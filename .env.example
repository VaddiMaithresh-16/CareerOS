APP_ENV=development

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=careeros
MYSQL_USER=careeros
MYSQL_PASSWORD=

# Leave DATABASE_URL unset for local dev to use SQLite (sqlite:///./careeros_dev.db)
# Or set it to your MySQL connection string
DATABASE_URL=

# Job APIs
# JOB_API_MODE=live requires at least one configured source or free source
JOB_API_MODE=live
JOB_SOURCES=jsearch,adzuna,remotive,remoteok,arbeitnow

JSEARCH_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# AI & Embeddings
QDRANT_URL=./qdrant_local
LLAMA_CPP_BASE_URL=http://localhost:8080
LLM_PROVIDER_MODE=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Verification
FIRECRAWL_API_KEY=

# Security & Limits
API_KEY=
RATE_LIMIT_PER_MINUTE=60
